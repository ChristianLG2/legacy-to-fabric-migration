    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Withdrawal tracks education level in a clean, monotonic gradient",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "  from 23% (postgraduate, n=252) up to 43% (no formal qualifications, n=306), holding through the two largest groups too (A-Level: 28% of 12,355; Lower-than-A-Level: 35% of 11,780). Not driven by the small groups at either end."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Withdrawal tracks socioeconomic deprivation (IMD band) in an even cleaner gradient",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " 37% in the most-deprived decile down to 26% in the least-deprived, across bands all above 2,200 students. The \"Unknown\" band (971 students, no mapped IMD) sits lowest of all at 21%, worth investigating separately rather than treating as random missingness."
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Withdrawal is remarkably stable across region",
                    "textStyle": {
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " (23%–35% across all 11 UK regions, none under 1,000 students), geography is not where this outcome gap lives; socioeconomic and educational factors are the stronger signa"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
